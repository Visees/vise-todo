# Copy to .env for local use. In Coolify, paste these with real values.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# The exact public address of the app (Coolify: the domain assigned to the frontend service).
SITE_URL=http://localhost:8090
# true behind HTTPS (production). The local override sets it to false.
COOKIE_SECURE=true
# Public sign-up. false: only the first account signs up (and becomes admin); admins create the rest.
ALLOW_SIGNUP=false

# Local only
LOCAL_WEB_PORT=8090
LOCAL_PG_PORT=5436
